    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.4",
    "exceljs": "^4.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.49.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "playwright": "^1.63.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
